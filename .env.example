# ============================================================
# Configuración MeshCentral — copiar a .env y completar
# (el .env NUNCA se sube al repositorio)
# ============================================================

# URL base del servidor MeshCentral
VITE_MESH_CENTRAL_URL=https://mesh.donnet.com.ar

# API key / ServerSecret de la cuenta administradora.
# Se configura en config.json de MeshCentral:
#   "users": { "admin@dominio": { ..., "serverSecret": "CLAVE_LARGA_ALEATORIA" } }
# o por dominio: "domains": { "*": { "AccountTypes": { "admin": { "ServerSecret": "..." } } } }
# Sin esto, la API REST /api/* responde 404 y ni la app web ni los scripts podrán conectarse.
VITE_MESH_API_KEY=

# (Opcional) Proxy server-side (Supabase Edge Function) que agrega las
# credenciales; si se define, la app lo usa en lugar de conectar directo.
VITE_MESH_PROXY_URL=

# ---- Variables SOLO para los scripts CLI (scripts/cli/*.mjs) ----
# No usar credenciales reales de producción en el navegador.
MESH_URL=https://mesh.donnet.com.ar
MESH_USER=
MESH_PASS=
MESH_TOKEN=
MESH_PC=
